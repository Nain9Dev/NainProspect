# Copia este archivo como .env y rellena las claves que vayas a usar.
# El .env NUNCA se sube al repositorio (ver .gitignore).
# Si falta una clave, el pipeline entra automaticamente en modo simulacion
# para esa parte y no realiza llamadas de pago.

# Clasificacion con Claude Haiku 4.5. Obligatoria para clasificar de verdad.
ANTHROPIC_API_KEY=

# Scraping de fichas publicas de Google Maps. Obligatoria para scraping real.
APIFY_API_TOKEN=

# Actor de Apify usado para Google Maps. Cambialo si usas otro.
APIFY_ACTOR_ID=compass/crawler-google-places

# Notificaciones. Opcionales: si faltan, los avisos se imprimen por consola.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Envio de email. NO se usa en esta fase: el pipeline solo simula el envio.
RESEND_API_KEY=

# Datos de identificacion del remitente, obligatorios en las plantillas
# por el articulo 21 de la LSSI-CE. Se insertan en el pie de cada email.
SENDER_COMPANY_NAME=
SENDER_LEGAL_ID=
SENDER_ADDRESS=
SENDER_OPTOUT_EMAIL=
